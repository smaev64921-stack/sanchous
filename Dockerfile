# ══════════════════════════════════════════════════════════════════════
#  Образ для хостинга (Bothost и любой другой, кто собирает по Dockerfile).
#
#  Зависимостей у проекта нет вообще: main.py написан на стандартной
#  библиотеке Python — ни requirements.txt, ни pip install не нужны.
#
#  Код держим ВНЕ /app: Bothost монтирует туда свой том с гитом и
#  данными, и файлы образа под этим монтированием просто исчезли бы.
# ══════════════════════════════════════════════════════════════════════
FROM python:3.12-slim

WORKDIR /usr/src/app

COPY . .

# Без этого print() копится в буфере, и в «Логах работы» панели пусто,
# пока процесс не завершится, — то есть никогда.
ENV PYTHONUNBUFFERED=1

# Обратный прокси хостинга стучится на 3000. Системная переменная PORT
# может перекрыть пользовательскую, поэтому сервер слушает несколько
# портов сразу (см. PORTS в main.py) — 3000 среди них обязателен.
EXPOSE 3000

# Один процесс: сайт и телеграм-бот.
CMD ["python", "main.py"]
