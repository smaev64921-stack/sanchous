# Переменные окружения для бота «Санчоус».
# Реальные значения вписываются в панели хостинга, а НЕ в репозиторий.

# Токен бота от @BotFather — обязательно
BOT_TOKEN=

# Публичный HTTPS-адрес сайта, который выдаёт хостинг.
# Без него Telegram не разрешит кнопку Mini App (нужен именно https).
PUBLIC_URL=

# Порт веб-сервера. Многие хостинги подставляют его сами.
PORT=8080

# Необязательно: id чата, куда дублировать заказы
ADMIN_ID=
